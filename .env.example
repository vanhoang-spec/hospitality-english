# Supabase — sao chép file này thành `.env` và điền giá trị thật.
# KHÔNG commit file `.env` lên git. Trên Netlify, khai báo các biến này trong
# Site settings → Environment variables.

# --- Dùng phía client (được nhúng vào bundle trình duyệt, an toàn để lộ) ---
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"

# --- Dùng phía server (SSR / server functions) ---
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-publishable-anon-key>"
SUPABASE_PROJECT_ID="<your-project-ref>"

# --- SECRET phía server — bypass RLS. TUYỆT ĐỐI không để lộ ra client, không commit ---
# Bắt buộc nếu dùng supabaseAdmin (src/integrations/supabase/client.server.ts).
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"
